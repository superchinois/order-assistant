# Copy this file to `.env` and fill in your real values. Never commit `.env`.
# Docker Compose reads these variables and injects them into the container.

# --- MongoDB ---
MONGO_USER=changeme
MONGO_PASSWORD=changeme
MONGO_HOST=localhost
MONGO_DATABASE=analytics
MONGO_STOCK_COLLECTION=raw-data
MONGO_REVENUES_COLLECTION=rev-raw-data

# --- Odoo ---
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your-odoo-db
ODOO_USERNAME=your-odoo-user

# Streamlit access
ODOO_APIKEY=changeme

# --- Ollama LLM ---
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=changeme

# --- MCP knowledge-base server ---
MCP_URL=http://172.19.0.1:3800/mcp

# --- App ---
PORT=8501
